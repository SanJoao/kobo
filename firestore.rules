rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Safely get user settings, returning null if they don't exist
    function getUserSettingsSafe(userId) {
      let settingsPath = /databases/$(database)/documents/users/$(userId)/settings/privacy;
      return exists(settingsPath) ? get(settingsPath).data : null;
    }

    function isFriend(userId, viewerId) {
      // Check if viewerId follows userId (simplified version)
      return exists(/databases/$(database)/documents/users/$(userId)/followers/$(viewerId));
    }

    // Helper to check visibility with fallback to public
    function checkVisibility(visibility, userId) {
      return visibility == 'public' 
        || visibility == null  // Fallback if visibility not set
        || (isAuthenticated() && isOwner(userId))
        || (visibility == 'friends' && isAuthenticated() && isFriend(userId, request.auth.uid));
    }

    function canViewProfile(userId) {
      // Owner can always view own profile
      // If no settings exist, default to public
      let settings = getUserSettingsSafe(userId);
      let visibility = settings != null ? settings.get('profileVisibility', 'public') : 'public';
      return checkVisibility(visibility, userId);
    }

    function canViewHighlight(userId, highlightData) {
      // Owner can always view own highlights
      // Check per-highlight visibility if set, otherwise use default (public)
      let settings = getUserSettingsSafe(userId);
      let defaultVisibility = settings != null ? settings.get('highlightVisibilityDefault', 'public') : 'public';
      let highlightVisibility = highlightData.get('visibility', defaultVisibility);
      return checkVisibility(highlightVisibility, userId);
    }

    function canViewStats(userId) {
      let settings = getUserSettingsSafe(userId);
      let visibility = settings != null ? settings.get('statsVisibility', 'public') : 'public';
      return checkVisibility(visibility, userId);
    }

    function canViewBooks(userId) {
      let settings = getUserSettingsSafe(userId);
      let visibility = settings != null ? settings.get('booksVisibility', 'public') : 'public';
      return checkVisibility(visibility, userId);
    }

    // User documents - allow read for social proof counting
    match /users/{userId} {
      // Allow listing users for social proof (counting)
      allow read: if true;
      allow write: if isOwner(userId);

      // Settings subcollection
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Books subcollection
      match /books/{bookId} {
        allow read: if canViewBooks(userId);
        allow write: if isOwner(userId);
      }

      // Highlights subcollection
      match /highlights/{highlightId} {
        // For individual highlight reads, check visibility
        // For landing page, we use collectionGroup query which has its own rules
        allow read: if canViewHighlight(userId, resource.data);
        allow write: if isOwner(userId);

        // Allow likes update only
        allow update: if isAuthenticated() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likeCount']);

        // Comments subcollection
        match /comments/{commentId} {
          // Allow read if the highlight is visible to the user (same visibility rules)
          allow read: if canViewHighlight(userId, get(/databases/$(database)/documents/users/$(userId)/highlights/$(highlightId)).data);
          // Writes are handled by Cloud Functions only
          allow write: if false;
        }
      }

      // Words/vocabulary subcollection
      match /words/{wordId} {
        allow read: if true; // Allow reading for social proof counting
        allow write: if isOwner(userId);
      }

      // Feed subcollection
      match /feed/{feedId} {
        allow read: if isOwner(userId);
        allow write: if false; // Written by Cloud Functions only
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow write: if false; // Written by Cloud Functions only
      }

      // Groups user has joined
      match /groups/{groupId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Followers subcollection
      match /followers/{followerId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == followerId;
      }

      // Following subcollection
      match /following/{followingId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // CollectionGroup queries for highlights (used in public feed/landing page)
    match /{path=**}/highlights/{highlightId} {
      // Allow read if highlight is public or visibility not set (default public)
      allow read: if resource.data.get('visibility', 'public') == 'public';
    }

    // CollectionGroup queries for books
    match /{path=**}/books/{bookId} {
      allow read: if true; // Read-only, privacy checked at user level
    }

    // CollectionGroup queries for words
    match /{path=**}/words/{wordId} {
      allow read: if true; // Read-only, privacy checked at user level
    }

    // Processing status
    match /processingStatus/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Public highlight links (for /h/{shortId} sharing)
    match /publicHighlights/{shortId} {
      allow read: if true; // Public by definition
      allow write: if isAuthenticated(); // Any authenticated user can create public links
    }

    // Reading groups
    match /groups/{groupId} {
      allow read: if true; // Public groups are readable by anyone
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';

      // Group members
      match /members/{memberId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Group posts
      match /posts/{postId} {
        allow read: if true;
        allow write: if isAuthenticated() && 
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
    }
  }
}

